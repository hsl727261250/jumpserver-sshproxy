# 复制为 .env 后按环境修改。部署时只改 .env，不改 docker-compose.yml。

# 本地镜像名和版本。./build.sh 会打这个标签。
# 换到仓库镜像时，把地址写成 registry.example.com/jumpserver-sshproxy。
SSHPROXY_IMAGE=jumpserver-sshproxy
SSHPROXY_VERSION=latest

# 宿主机映射端口。容器内固定监听 1024。
SSHPROXY_PORT=1024

# Core 所在的已有 Docker 网络名称。
SSHPROXY_NETWORK=jumpserver

# 宿主机数据目录，挂载到容器内 /opt/sshproxy/data。
SSHPROXY_DATA_DIR=/opt/jumpserver-data/koko/data

# JumpServer Core 地址，必须能从容器网络访问。
CORE_HOST=http://core:8080

# 与 Core 配置中的 BOOTSTRAP_TOKEN 保持一致。AccessKey 写入数据卷后可留空。
BOOTSTRAP_TOKEN=
